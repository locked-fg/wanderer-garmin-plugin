{
  "manifestVersion": "1.0",
  "id": "garmin",
  "type": "trails",
  "name": "Garmin",
  "description": "Imports Garmin activities and routes into wanderer.",
  "version": "0.1.0",
  "runtime": {
    "type": "wasm",
    "entrypoint": "plugin.wasm"
  },
  "capabilities": [
    {
      "name": "list_routes",
      "version": "v1",
      "export": "list_routes_v1"
    },
    {
      "name": "get_route_detail",
      "version": "v1",
      "export": "get_route_detail_v1"
    },
    {
      "name": "list_activities",
      "version": "v1",
      "export": "list_activities_v1"
    },
    {
      "name": "get_activity_detail",
      "version": "v1",
      "export": "get_activity_detail_v1"
    }
  ],
  "auth": {
    "contexts": {
      "bearer_token": {
        "type": "bearer",
        "fields": ["apiKey"],
        "secretFields": ["apiKey"]
      }
    }
  },
  "permissions": {
    "network": {
      "connectors": [
        {
          "name": "api",
          "type": "public_api",
          "fixedBaseURL": "https://personal.connectapi.garmin.com",
          "allowedPathPrefixes": [
            "/activitylist-service",
            "/activity-service",
            "/download-service",
            "/userprofile-service"
          ],
          "auth": [
            "bearer_token"
          ]
        }
      ]
    },
    "auth": [
      "bearer_token"
    ],
    "downloads": {
      "maxBytes": 16777216,
      "contentTypes": [
        "application/json",
        "application/gpx+xml",
        "application/xml",
        "text/xml",
        "application/octet-stream",
        "application/zip"
      ]
    }
  },
  "configSchema": [
    {
      "key": "after",
      "type": "date",
      "label": "Start date",
      "labels": {
        "de": "Startdatum",
        "en": "Start date"
      },
      "description": "Ignore activities and routes before this date.",
      "descriptions": {
        "de": "Aktivitäten und Routen vor diesem Datum ignorieren.",
        "en": "Ignore activities and routes before this date."
      }
    }
  ],
  "hostConfig": {
    "categoryMapping": {
      "running": { "category": "Running", "subcategory": "Road" },
      "trail_running": { "category": "Running", "subcategory": "Trail" },
      "cycling": { "category": "Biking", "subcategory": "Road" },
      "mountain_biking": { "category": "Biking", "subcategory": "MTB" },
      "gravel_cycling": { "category": "Biking", "subcategory": "Gravel" },
      "hiking": "Hiking",
      "walking": "Walking",
      "swimming": "Other",
      "skiing": "Skiing",
      "snowboarding": "Skiing",
      "cross_country_skiing": { "category": "Skiing", "subcategory": "Cross-country" },
      "alpine_skiing": { "category": "Skiing", "subcategory": "Alpine" },
      "backcountry_skiing": { "category": "Skiing", "subcategory": "Backcountry" },
      "kayaking": "Canoeing",
      "rowing": "Canoeing",
      "paddle_boarding": "Canoeing",
      "climbing": "Climbing",
      "rock_climbing": "Climbing",
      "ice_climbing": "Climbing",
      "e_bike_mountain": { "category": "Biking", "subcategory": "E-Bike" },
      "e_bike_road": { "category": "Biking", "subcategory": "E-Bike" },
      "e_bike_cargo": { "category": "Biking", "subcategory": "E-Bike" },
      "other": "Other"
    }
  },
  "metadata": {
    "descriptions": {
      "de": "Importiert Garmin-Aktivitäten und -Routen in wanderer.",
      "en": "Imports Garmin activities and routes into wanderer."
    },
    "information": {
      "de": "Dieses Plugin verbindet wanderer über die offizielle Garmin Personal API mit deinem Garmin-Konto. Es importiert Aktivitäten, Routen und zugehörige Daten. Für die Verbindung hinterlegst du deinen persönlichen Garmin API-Key.",
      "en": "This plugin connects wanderer to your Garmin account through the official Garmin Personal API. It imports activities, routes, and their data. To connect, provide your Garmin Personal API key."
    },
    "homepageUrl": "https://developer.garmin.com/gc-developer-program/personal/personal-api/",
    "icons": {
      "light": "icon.svg"
    },

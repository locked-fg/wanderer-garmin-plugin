  "name": "Garmin",
  "permissions": {
    "auth": [
      "api_key",
      "bearer_token"
    ],
    "downloads": {
      "contentTypes": [
        "application/json",
        "application/gpx+xml",
        "application/xml",
        "text/xml",
        "application/octet-stream",
        "application/zip"
      ],
      "maxBytes": 16777216
    },
    "network": {
      "connectors": [
        {
          "allowedPathPrefixes": [
            "/personalapitoken-service",
            "/activitylist-service",
            "/activity-service"
          ],
          "auth": [
            "bearer_token"
          ],
          "fixedBaseURL": "https://personal.connectapi.garmin.com",
          "name": "api",
          "type": "public_api"
        }
      ]
    }
  },
  "runtime": {
    "entrypoint": "plugin.wasm",
    "type": "wasm"
  },
  "type": "trails",
  "version": "0.1.0"

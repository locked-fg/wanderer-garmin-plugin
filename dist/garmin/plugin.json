  "id": "garmin",
  "manifestVersion": "1.0",
  "metadata": {
    "descriptions": {
      "de": "Importiert Garmin-Aktivitäten und -Routen in wanderer.",
      "en": "Imports Garmin activities and routes into wanderer."
    },
    "homepageUrl": "https://developer.garmin.com/gc-developer-program/personal/personal-api/",
    "icons": {
      "light": "icon.svg"
    },
    "information": {
      "de": "Dieses Plugin verbindet wanderer über die offizielle Garmin Personal API mit deinem Garmin-Konto. Es importiert Aktivitäten, Routen und zugehörige Daten. Für die Verbindung hinterlegst du deinen persönlichen Garmin API-Key.",
      "en": "This plugin connects wanderer to your Garmin account through the official Garmin Personal API. It imports activities, routes, and their data. To connect, provide your Garmin Personal API key."
    },
